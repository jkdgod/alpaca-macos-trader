APCA_API_KEY_ID=replace_with_your_paper_key_id
APCA_API_SECRET_KEY=replace_with_your_paper_secret_key
APCA_API_BASE_URL=https://paper-api.alpaca.markets
TRADING_MODE=paper
ALPACA_DATA_FEED=iex
WATCHLIST=SPY,QQQ
FAST_EMA_PERIOD=9
SLOW_EMA_PERIOD=21
VOLUME_LOOKBACK=20
VOLUME_MULTIPLIER=1.20
MIN_BARS_REQUIRED=30
WARMUP_BARS=120
MAX_ALLOCATION_PCT=0.10
MAX_TRADE_DOLLARS=2500.00
MAX_DAILY_DRAWDOWN_PCT=0.02
MAX_POSITIONS=2
MAX_GROSS_LEVERAGE=1.00
STOP_LOSS_PCT=0.0075
TAKE_PROFIT_PCT=0.0150
CLOSE_INTRADAY_POSITIONS=true
STATE_DIRECTORY=runtime
LOG_DIRECTORY=logs
LOG_LEVEL=INFO
